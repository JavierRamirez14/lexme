# Copy to `.env` (gitignored) and set your own values before `docker compose up`.

POSTGRES_USER=lexme
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lexme

# Vertical data packages (ingestion manifest, disambiguation branches). docker
# compose mounts ./verticales here; set it to the repo's own ./verticales when
# running the API outside compose. Defaults to /verticales when unset.
VERTICALS_DIR=/verticales

# Where `eval run` writes its versionable run artifacts. docker compose mounts
# ./eval-runs here (writable); set it to a real path when running outside compose.
# Defaults to /eval-runs when unset.
EVAL_RUNS_DIR=/eval-runs

# How many times `eval run` runs the suite under one fingerprint, so each metric
# is published as the band it moved in instead of a single draw. Every repetition
# costs a full set of model calls, so the default is 1 and raising it is a
# deliberate spend against the provider quota; `--repeat` overrides it per run.
EVAL_REPETITIONS=1

# LLM providers. The task->model map lives in api/src/lexme/llm/tasks.json; these
# keys let the adapters reach the providers it names. Only the providers
# referenced there need a key.
#   Gemini AI Studio: https://aistudio.google.com/apikey
#   OpenRouter:       https://openrouter.ai/keys
#
# Everything the product itself runs on is a Gemini free tier. OpenRouter serves
# one task only, and it is not a runtime one: the eval harness's LLM judge, pinned
# to `deepseek/deepseek-v3.2` at temperature 0. That model is paid, so the key
# needs credit on it -- of the order of cents per run, since the judge sees 13
# cases per repetition. Without that credit, run the harness unjudged
# (`make eval JUDGE=off`): every non-judged metric is still measured, and the run
# publishes no completeness, no claim rate and no reviewer agreement rather than
# an unbacked one.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Frontend: base URL of the API the SPA calls. docker compose sets this for the
# frontend container; override it for a local `npm run dev` against a remote API.
# Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Corpus integration tests (`make test-integration`) build their data in a
# separate `lexme_test` database on the db service. The target derives the DSN
# from the values above; to run pytest directly, export it yourself:
#   LEXME_TEST_DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/lexme_test
