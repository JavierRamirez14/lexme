# Copy to `.env` (gitignored) and set your own values before `docker compose up`.

POSTGRES_USER=lexme
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lexme

# LLM providers (free tiers). The task->model map lives in
# api/src/lexme/llm/tasks.json; these keys let the adapters reach the providers
# it names. Only the providers referenced there need a key.
#   Gemini AI Studio: https://aistudio.google.com/apikey
#   OpenRouter:       https://openrouter.ai/keys
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Frontend: base URL of the API the SPA calls. docker compose sets this for the
# frontend container; override it for a local `npm run dev` against a remote API.
# Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Corpus integration tests (`make test-integration`) build their data in a
# separate `lexme_test` database on the db service. The target derives the DSN
# from the values above; to run pytest directly, export it yourself:
#   LEXME_TEST_DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/lexme_test
